# Bloomberg MCP Gateway — environment configuration example.
# Copy to .env (never committed) or set these in the process environment.
# Bearer tokens MUST contain at least 256 bits (32 bytes) of random entropy,
# e.g. generated with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# Current bearer token (required unless auth.token_source=windows_credential_manager)
BLOOMBERG_MCP_BEARER_TOKEN=

# Previous token accepted during the bounded rotation overlap window
BLOOMBERG_MCP_BEARER_TOKEN_PREVIOUS=

# Optional path overrides
# BLOOMBERG_MCP_CONFIG=config/default.yaml
# BLOOMBERG_MCP_POLICY=config/policy.example.yaml

# Backend selection: native (Bloomberg Desktop API) or fake (deterministic CI backend)
# BLOOMBERG_MCP_BACKEND=native

# Logging level override
# BLOOMBERG_MCP_LOG_LEVEL=INFO
